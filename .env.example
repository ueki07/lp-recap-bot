# Copie ce fichier en .env pour tourner en local.
# En prod (GitHub Actions), ces valeurs viennent des secrets/variables du repo.

# Onglet "Bot" de ton application sur https://discord.com/developers/applications
DISCORD_TOKEN=

# Clic droit sur le salon > Copier l'identifiant (mode développeur activé).
# RECAP_CHANNEL_ID  : où le récap quotidien est publié.
# COMMAND_CHANNEL_ID: où le bot lit les `!lp ...`. Peut être le même salon.
RECAP_CHANNEL_ID=
COMMAND_CHANNEL_ID=

# Heure de la borne de fenêtre : le récap couvre 9h -> 9h et tombe à 9h05.
RECAP_HOUR=9
RECAP_DELAY_MINUTES=5
TIMEZONE=Europe/Paris

# 1 pour compter aussi la Flex dans le récap (0 = SoloQ uniquement).
INCLUDE_FLEX=0

# Saison u.gg en cours. À incrémenter au changement de saison :
# le récap renverrait sinon 0 game pour tout le monde, sans erreur.
UGG_SEASON_ID=26

# --- uniquement pour le mode bot permanent (src/bot.py) ---
# Synchronise les slash commands sur ce serveur -> disponibles immédiatement.
GUILD_ID=
